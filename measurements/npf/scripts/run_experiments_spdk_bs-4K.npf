%info
// mode will be set up automically by fish script
// Alternatively, you can manually run npf and set up a mode
spdk_bdev fio [rw] benchmark

%config

n_runs=5
var_names={BANDWIDTH:Throughput,ENGINE:I/O engine,SIZE:File size (MB)}
var_unit={BANDWIDTH:B/s,SIZE:B}
var_divider={BANDWIDTH:1,SIZE:0.000001}
var_format={BANDWIDTH:eng.0,SIZE:eng.0.B}
graph_serie=ENGINE
graph_type=barplot
%variables
SIZE={4,10,100,1024}
ENGINE={spdk_bdev,libaio,io_uring}

%late_variables
RW={rw}
PCI_ADDRESS={0000:02:00.0}
NVME={nvme0n2}

%script@server sudo=true

if [[ "${RW}" == *"rw" ]];
then
    MIXED_PARAMS="--rwmixread=70 --norandommap=1"
else
    MIXED_PARAMS=""
fi

if [[ "${ENGINE}" == "spdk_bdev" ]];
then
    if [ -b "/dev/${NVME}" ]; then
        PCI_ALLOWED=${PCI_ADDRESS} /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh
        while [ -b "/dev/${NVME}" ]; do
            echo "Waiting to bind SPDK (${NVME})..."
            sleep 1
        done
    fi
    cat > "/tmp/benchmark-conf.json" << JSON
{
  "subsystems": [
    {
      "subsystem": "bdev",
      "config": [
        {
          "method": "bdev_nvme_attach_controller",
          "params": {
            "name": "Nvme0",
            "trtype": "PCIe",
            "traddr": "${PCI_ADDRESS}"
          }
        }
      ]
    }
  ]
}
JSON

    LD_PRELOAD=/etinfo/users/2021/njeanmenne/spdk/build/fio/spdk_bdev fio --name=npf_spdk-fio_read \
              --ioengine=${ENGINE} \
              --spdk_json_conf=/tmp/benchmark-conf.json \
              --filename=Nvme0n1 \
              --direct=1 \
              --thread=1 \
              --overwrite=1 \
              --time_based=1 \
              --runtime=10 \
              --ramp_time=3 \
              --rw=${RW} \
              --bs=4K \
              --iodepth=64 \
              --size=${SIZE}M \
              ${MIXED_PARAMS} \
              --output-format=json > fio.json
else

    if [ ! -b "/dev/${NVME}" ]; then
        /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh reset
        while [ ! -b "/dev/${NVME}" ]; do
            echo "Waiting to bind nvme driver (${NVME})..."
            sleep 1
        done
    fi
  
    fio --name=npf_spdk-fio_read \
              --ioengine=${ENGINE} \
              --filename=/dev/${NVME} \
              --direct=1 \
              --thread=1 \
              --overwrite=1 \
              --rw=${RW} \
              --bs=4K \
              --iodepth=64 \
              --size=${SIZE}M \
              ${MIXED_PARAMS} \
              --output-format=json > fio.json
fi

if [[ "${RW}" == *"read"* ]];
then
    bw_bps=$(jq '.jobs[0].read.bw_bytes' fio.json)
else
    bw_bps=$(jq '.jobs[0].write.bw_bytes' fio.json)
fi

echo "RESULT-BANDWIDTH $bw_bps"

