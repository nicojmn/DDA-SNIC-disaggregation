%info
// mode will be set up automically by fish script
// Alternatively, you can manually run npf and set up a mode
multicore [mode] benchmark


%config

n_runs=3
var_names={BANDWIDTH:Throughput,ENGINE:I/O engine,SIZE:File size (MB),CORES:Number of cores}
var_unit={BANDWIDTH:B/s,SIZE:B}
var_divider={BANDWIDTH:1,SIZE:0.000001}
var_format={BANDWIDTH:eng.0,SIZE:eng.0.B}
graph_serie=ENGINE
graph_type=barplot
%variables
// SIZE={4,10,100,1024}
SIZE={1}
CORES={1,2,3,4,5,6,7,8,16}
ENGINE={libaio,io_uring}

%late_variables
RW={randwrite}
PCI_ADDRESS={0000:02:00.0}
NVME={nvme0n2}
CPU_BASE=0

%script@server sudo=true

if [[ "${RW}" == *"rw" ]];
then
    MIXED_PARAMS="--rwmixread=70 --norandommap=1"
else
    MIXED_PARAMS=""
fi

if [[ "${ENGINE}" == "spdk_bdev" ]];
then
    if [ -b "/dev/${NVME}" ]; then
        PCI_ALLOWED=${PCI_ADDRESS} /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh
        while [ -b "/dev/${NVME}" ]; do
            echo "Waiting to bind SPDK (${NVME})..."
            sleep 1
        done
    fi
    cat > "/tmp/benchmark-conf.json" << JSON
{
  "subsystems": [
    {
      "subsystem": "bdev",
      "config": [
        {
          "method": "bdev_nvme_attach_controller",
          "params": {
            "name": "Nvme0",
            "trtype": "PCIe",
            "traddr": "${PCI_ADDRESS}"
          }
        }
      ]
    }
  ]
}
JSON

    LD_PRELOAD=/etinfo/users/2021/njeanmenne/spdk/build/fio/spdk_bdev fio --name=spdk \
              --ioengine=${ENGINE} \
              --spdk_json_conf=/tmp/benchmark-conf.json \
              --filename=Nvme0n1 \
              --direct=1 \
              --thread=1 \
              --overwrite=1 \
              --time_based=1 \
              --runtime=10 \
              --ramp_time=3 \
              --rw=${RW} \
              --bs=4K \
              --iodepth=64 \
              --size=${SIZE}M \
              ${MIXED_PARAMS} \
              --output-format=json > fio.json
else

    if [ ! -b "/dev/${NVME}" ]; then
        /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh reset
        while [ ! -b "/dev/${NVME}" ]; do
            echo "Waiting to bind nvme driver (${NVME})..."
            sleep 1
        done
    fi

    CPU_LAST=$(( ${CPU_BASE} + ${CORES} - 1 ))
    echo "Allowing cores 0-$CPU_LAST"
  
    fio --name=kernel-paths \
            --ioengine=${ENGINE} \
            --filename=/dev/${NVME} \
            --direct=1 \
            --thread=1 \
            --numjobs=${CORES} \
            --cpus_allowed=${CPU_BASE}-${CPU_LAST}\
            --cpus_allowed_policy=split \
            --stonewall \
            --overwrite=1 \
            --time_based=1 \
            --runtime=10 \
            --ramp_time=3 \
            --rw=${RW} \
            --bs=4K \
            --iodepth=64 \
            --size=${SIZE}M \
            ${MIXED_PARAMS} \
            --output-format=json > fio.json
fi

if [[ "${RW}" == *"read"* ]];
then
    bw_bps=$(jq '[.jobs[].read.bw_bytes] | add' fio.json)
else
    bw_bps=$(jq '[.jobs[].write.bw_bytes] | add' fio.json)
fi

echo "RESULT-BANDWIDTH $bw_bps"

