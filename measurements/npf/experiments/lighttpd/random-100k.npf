%info
Benchmark IO-TCP

%config

// n_runs=5
n_runs=1
var_names={BANDWIDTH:Throughput,SIZE:File size,CONNECTIONS: Concurrent connections}
var_unit={BANDWIDTH:b/s,SIZE:B}
var_divider={BANDWIDTH:1}
var_format={BANDWIDTH:eng.0}
graph_type=barplot
graph_grid=true

%variables
CONNECTIONS={10,100,200,400,800,1600,3200,6400,12800}

%late_variables
THREAD={8}

// %script@bluefield sudo=true
// uname -a
// killall -w -9 lighttpd 2> /dev/null || true

// cd $HOME/lighttpd1.4-lighttpd-1.4.32/src
// taskset -c 0 ./lighttpd -D -f ./test.conf

%script@frodo sudo=true

killall -w -9 lighttpd 2> /dev/null || true

cd $HOME/lighttpd1.4-lighttpd-1.4.32/src
taskset -c 0 ./lighttpd -D -f ./test.conf

%script@wrk sudo=true delay=5
sysctl -w net.ipv4.ip_local_port_range="1024 65535"
sysctl -w net.core.somaxconn=65535
ulimit -n 1048576
wrk -t ${THREAD} -c ${CONNECTIONS} -d 5 -s $HOME/master-thesis/measurements/npf/experiments/lighttpd/random-100k.lua http://10.0.25.100:8888 &> /tmp/npf-wrk.log

BW=$(grep 'Transfer/sec:' /tmp/npf-wrk.log | awk '{
    v = $2
    sub(/[A-Za-z]+$/, "", v)
    if (index($2, "KB")) v *= 1000
    else if (index($2, "MB")) v *= 1000000
    else if (index($2, "GB")) v *= 1000000000
    printf "%.0f", v * 8
}')

echo "RESULT-BANDWIDTH $BW"

killall -w -9 lighttpd 2> /dev/null || true
